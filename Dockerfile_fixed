FROM python:3.12-slim
RUN pip install --no-cache-dir "streamlit>=1.40" "pandas>=2.2"
WORKDIR /app
RUN printf '%s' '' > /tmp/app.b64
RUN printf '%s' '' >> /tmp/app.b64
RUN printf '%s' '' >> /tmp/app.b64
RUN printf '%s' '' >> /tmp/app.b64
RUN printf '%s' '' >> /tmp/app.b64
RUN printf '%s' '' >> /tmp/app.b64
RUN python -c "import base64; open('/app/app.py','wb').write(base64.b64decode(open('/tmp/app.b64','rb').read()))"
RUN rm /tmp/app.b64
EXPOSE 8080
CMD ["sh","-c","streamlit run /app/app.py --server.address=0.0.0.0 --server.port=${PORT:-8080} --server.headless=true"]
